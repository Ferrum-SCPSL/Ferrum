<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><DefineConstants>$(DefineConstants);FERRUM_BOOTSTRAP</DefineConstants></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ferrum.Contracts/Ferrum.Contracts.csproj" />
    <PackageReference Include="Northwood.LabAPI" Version="1.1.7" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="YamlDotNet" Version="11.0.1" IncludeAssets="compile" PrivateAssets="all" />
    <Compile Include="../Ferrum.Localization/*.cs" Link="Features/Localization/%(Filename)%(Extension)" />
    <Compile Include="../Ferrum.Updater/Packages/PackageIntegrity.cs" Link="Features/Verification/PackageIntegrity.cs" />
    <Compile Include="../Ferrum.Updater/Versions/ReleaseVersion.cs" Link="Features/Verification/ReleaseVersion.cs" />
    <EmbeddedResource Include="../Ferrum.Localization/Catalogs/*.csv" LogicalName="Ferrum.Localization.Catalogs.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
