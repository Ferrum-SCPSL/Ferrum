<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained><PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName Condition="'$(RuntimeIdentifier)' == 'win-x64'">Ferrum.Installer-Win</AssemblyName>
    <AssemblyName Condition="'$(RuntimeIdentifier)' == 'linux-x64'">Ferrum.Installer-Linux</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ferrum.Contracts/Ferrum.Contracts.csproj" />
    <ProjectReference Include="../Ferrum.Localization/Ferrum.Localization.csproj" />
    <ProjectReference Include="../Ferrum.Updater/Ferrum.Updater.csproj" />
    <PackageReference Include="YamlDotNet" Version="11.0.1" />
    <EmbeddedResource Include="../release.json" LogicalName="Ferrum.Release" />
  </ItemGroup>
</Project>
